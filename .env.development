# Clerk Authentication - Development
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_demo_key_replace_with_real_key

# RevenueCat Subscriptions - Development
EXPO_PUBLIC_REVENUECAT_IOS_KEY=demo_ios_key_replace_with_real_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=demo_android_key_replace_with_real_key

# Development
EXPO_ENV=development

# OCR Services Configuration

# OpenAI GPT Vision (Primary OCR) 
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here
EXPO_PUBLIC_OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Mistral AI OCR (Secondary)
EXPO_PUBLIC_MISTRAL_API_KEY=your_mistral_api_key_here
EXPO_PUBLIC_MISTRAL_API_URL=https://api.mistral.ai/v1/ocr

# OCR.space (Fallback)
EXPO_PUBLIC_OCR_SPACE_API_KEY=your_ocr_space_api_key_here

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: For server-side operations
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Cloud Sync Configuration
EXPO_PUBLIC_ENABLE_CLOUD_SYNC=true
EXPO_PUBLIC_ENABLE_REALTIME=true
EXPO_PUBLIC_SYNC_INTERVAL_MS=300000 # 5 minutes

# Development Settings
EXPO_PUBLIC_DEBUG_MODE=true
EXPO_PUBLIC_LOG_LEVEL=debug